; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pocket Lab · 口袋实验室"
run/main_scene="res://scenes/lab.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="PocketLab"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=450
window/size/viewport_height=900
window/size/window_width_override=450
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true
pointing/emulate_mouse_from_touch=false

[layer_names]

2d_physics/layer_1="Metal balls"
2d_physics/layer_2="Fixtures and boundary"

[physics]

2d/default_gravity=650.0
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.973, 0.961, 0.914, 1)
